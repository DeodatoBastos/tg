version: '3.8'
networks:
  citus_net:
    driver: bridge
    ipam:
      config:
      - subnet: 172.28.0.0/16
services:
  etcd1:
    image: quay.io/coreos/etcd:v3.5.10
    networks:
      citus_net:
        ipv4_address: 172.28.0.11
    environment: &id001
      ETCD_LISTEN_PEER_URLS: http://0.0.0.0:2380
      ETCD_LISTEN_CLIENT_URLS: http://0.0.0.0:2379
      ETCD_INITIAL_CLUSTER: etcd1=http://etcd1:2380,etcd2=http://etcd2:2380,etcd3=http://etcd3:2380
      ETCD_INITIAL_CLUSTER_STATE: new
      ETCD_INITIAL_CLUSTER_TOKEN: citus-cluster
      ETCD_UNSUPPORTED_ARCH: arm64
    container_name: citus_etcd1
    hostname: etcd1
    command: etcd --name etcd1 --initial-advertise-peer-urls http://etcd1:2380 --advertise-client-urls
      http://etcd1:2379
    volumes:
    - etcd1_data:/etcd-data
    restart: unless-stopped
    extra_hosts: &id002
    - etcd1:172.28.0.11
    - citus_etcd1:172.28.0.11
    - etcd2:172.28.0.12
    - citus_etcd2:172.28.0.12
    - etcd3:172.28.0.13
    - citus_etcd3:172.28.0.13
    - coordinator1:172.28.0.21
    - citus_coordinator1:172.28.0.21
    - coordinator2:172.28.0.22
    - citus_coordinator2:172.28.0.22
    - coordinator3:172.28.0.23
    - citus_coordinator3:172.28.0.23
    - worker1_primary:172.28.0.31
    - citus_worker1_primary:172.28.0.31
    - worker1_standby:172.28.0.32
    - citus_worker1_standby:172.28.0.32
    - worker2_primary:172.28.0.41
    - citus_worker2_primary:172.28.0.41
    - worker2_standby:172.28.0.42
    - citus_worker2_standby:172.28.0.42
    - haproxy:172.28.0.50
    - citus_haproxy:172.28.0.50
    - postgres_exporter:172.28.0.61
    - citus_postgres_exporter:172.28.0.61
    - prometheus:172.28.0.62
    - citus_prometheus:172.28.0.62
    - grafana:172.28.0.63
    - citus_grafana:172.28.0.63
  etcd2:
    image: quay.io/coreos/etcd:v3.5.10
    networks:
      citus_net:
        ipv4_address: 172.28.0.12
    environment: *id001
    container_name: citus_etcd2
    hostname: etcd2
    command: etcd --name etcd2 --initial-advertise-peer-urls http://etcd2:2380 --advertise-client-urls
      http://etcd2:2379
    volumes:
    - etcd2_data:/etcd-data
    restart: unless-stopped
    extra_hosts: *id002
  etcd3:
    image: quay.io/coreos/etcd:v3.5.10
    networks:
      citus_net:
        ipv4_address: 172.28.0.13
    environment: *id001
    container_name: citus_etcd3
    hostname: etcd3
    command: etcd --name etcd3 --initial-advertise-peer-urls http://etcd3:2380 --advertise-client-urls
      http://etcd3:2379
    volumes:
    - etcd3_data:/etcd-data
    restart: unless-stopped
    extra_hosts: *id002
  haproxy:
    image: citus-patroni:latest
    networks:
      citus_net:
        ipv4_address: 172.28.0.50
    container_name: citus_haproxy
    hostname: haproxy
    ports:
    - 15440:5000
    - 18008:8008
    command: haproxy
    environment:
      ETCDCTL_ENDPOINTS: http://etcd1:2379,http://etcd2:2379,http://etcd3:2379
      PATRONI_ETCD3_HOSTS: etcd1:2379,etcd2:2379,etcd3:2379
      PATRONI_SCOPE: citus-cluster
      PATRONI_CITUS_DATABASE: citus_platform
      POSTGRES_PASSWORD: postgres
      PGSSLMODE: prefer
    depends_on:
    - etcd1
    - etcd2
    - etcd3
    restart: unless-stopped
    extra_hosts: *id002
  coordinator1:
    image: citus-patroni:latest
    networks:
      citus_net:
        ipv4_address: 172.28.0.21
    container_name: citus_coordinator1
    hostname: coordinator1
    environment:
      ETCDCTL_ENDPOINTS: http://etcd1:2379,http://etcd2:2379,http://etcd3:2379
      PATRONI_ETCD3_HOSTS: etcd1:2379,etcd2:2379,etcd3:2379
      PATRONI_SCOPE: citus-cluster
      PATRONI_CITUS_DATABASE: citus_platform
      POSTGRES_PASSWORD: postgres
      PGSSLMODE: prefer
      PATRONI_NAME: coordinator1
      PATRONI_CITUS_GROUP: 0
    volumes:
    - coordinator1_data:/home/postgres/data
    - ./config:/config:ro
    depends_on:
    - etcd1
    - etcd2
    - etcd3
    restart: unless-stopped
    extra_hosts: *id002
  coordinator2:
    image: citus-patroni:latest
    networks:
      citus_net:
        ipv4_address: 172.28.0.22
    container_name: citus_coordinator2
    hostname: coordinator2
    environment:
      ETCDCTL_ENDPOINTS: http://etcd1:2379,http://etcd2:2379,http://etcd3:2379
      PATRONI_ETCD3_HOSTS: etcd1:2379,etcd2:2379,etcd3:2379
      PATRONI_SCOPE: citus-cluster
      PATRONI_CITUS_DATABASE: citus_platform
      POSTGRES_PASSWORD: postgres
      PGSSLMODE: prefer
      PATRONI_NAME: coordinator2
      PATRONI_CITUS_GROUP: 0
    volumes:
    - coordinator2_data:/home/postgres/data
    - ./config:/config:ro
    depends_on:
    - etcd1
    - etcd2
    - etcd3
    restart: unless-stopped
    extra_hosts: *id002
  coordinator3:
    image: citus-patroni:latest
    networks:
      citus_net:
        ipv4_address: 172.28.0.23
    container_name: citus_coordinator3
    hostname: coordinator3
    environment:
      ETCDCTL_ENDPOINTS: http://etcd1:2379,http://etcd2:2379,http://etcd3:2379
      PATRONI_ETCD3_HOSTS: etcd1:2379,etcd2:2379,etcd3:2379
      PATRONI_SCOPE: citus-cluster
      PATRONI_CITUS_DATABASE: citus_platform
      POSTGRES_PASSWORD: postgres
      PGSSLMODE: prefer
      PATRONI_NAME: coordinator3
      PATRONI_CITUS_GROUP: 0
    volumes:
    - coordinator3_data:/home/postgres/data
    - ./config:/config:ro
    depends_on:
    - etcd1
    - etcd2
    - etcd3
    restart: unless-stopped
    extra_hosts: *id002
  worker1_primary:
    image: citus-patroni:latest
    networks:
      citus_net:
        ipv4_address: 172.28.0.31
    container_name: citus_worker1_primary
    hostname: worker1-primary
    environment:
      ETCDCTL_ENDPOINTS: http://etcd1:2379,http://etcd2:2379,http://etcd3:2379
      PATRONI_ETCD3_HOSTS: etcd1:2379,etcd2:2379,etcd3:2379
      PATRONI_SCOPE: citus-cluster
      PATRONI_CITUS_DATABASE: citus_platform
      POSTGRES_PASSWORD: postgres
      PGSSLMODE: prefer
      PATRONI_NAME: worker1-primary
      PATRONI_CITUS_GROUP: 1
    volumes:
    - worker1_primary_data:/home/postgres/data
    - ./config:/config:ro
    depends_on:
    - etcd1
    - etcd2
    - etcd3
    restart: unless-stopped
    extra_hosts: *id002
  worker1_standby:
    image: citus-patroni:latest
    networks:
      citus_net:
        ipv4_address: 172.28.0.32
    container_name: citus_worker1_standby
    hostname: worker1-standby
    environment:
      ETCDCTL_ENDPOINTS: http://etcd1:2379,http://etcd2:2379,http://etcd3:2379
      PATRONI_ETCD3_HOSTS: etcd1:2379,etcd2:2379,etcd3:2379
      PATRONI_SCOPE: citus-cluster
      PATRONI_CITUS_DATABASE: citus_platform
      POSTGRES_PASSWORD: postgres
      PGSSLMODE: prefer
      PATRONI_NAME: worker1-standby
      PATRONI_CITUS_GROUP: 1
    volumes:
    - worker1_standby_data:/home/postgres/data
    - ./config:/config:ro
    depends_on:
    - etcd1
    - etcd2
    - etcd3
    restart: unless-stopped
    extra_hosts: *id002
  worker2_primary:
    image: citus-patroni:latest
    networks:
      citus_net:
        ipv4_address: 172.28.0.41
    container_name: citus_worker2_primary
    hostname: worker2-primary
    environment:
      ETCDCTL_ENDPOINTS: http://etcd1:2379,http://etcd2:2379,http://etcd3:2379
      PATRONI_ETCD3_HOSTS: etcd1:2379,etcd2:2379,etcd3:2379
      PATRONI_SCOPE: citus-cluster
      PATRONI_CITUS_DATABASE: citus_platform
      POSTGRES_PASSWORD: postgres
      PGSSLMODE: prefer
      PATRONI_NAME: worker2-primary
      PATRONI_CITUS_GROUP: 2
    volumes:
    - worker2_primary_data:/home/postgres/data
    - ./config:/config:ro
    depends_on:
    - etcd1
    - etcd2
    - etcd3
    restart: unless-stopped
    extra_hosts: *id002
  worker2_standby:
    image: citus-patroni:latest
    networks:
      citus_net:
        ipv4_address: 172.28.0.42
    container_name: citus_worker2_standby
    hostname: worker2-standby
    environment:
      ETCDCTL_ENDPOINTS: http://etcd1:2379,http://etcd2:2379,http://etcd3:2379
      PATRONI_ETCD3_HOSTS: etcd1:2379,etcd2:2379,etcd3:2379
      PATRONI_SCOPE: citus-cluster
      PATRONI_CITUS_DATABASE: citus_platform
      POSTGRES_PASSWORD: postgres
      PGSSLMODE: prefer
      PATRONI_NAME: worker2-standby
      PATRONI_CITUS_GROUP: 2
    volumes:
    - worker2_standby_data:/home/postgres/data
    - ./config:/config:ro
    depends_on:
    - etcd1
    - etcd2
    - etcd3
    restart: unless-stopped
    extra_hosts: *id002
  postgres_exporter_patroni:
    image: prometheuscommunity/postgres-exporter:latest
    container_name: citus_postgres_exporter_patroni
    hostname: postgres-exporter-patroni
    networks:
    - citus_net
    environment:
      DATA_SOURCE_NAME: postgresql://postgres:${POSTGRES_PASSWORD:-postgres}@haproxy:5000/citus?sslmode=disable
    ports:
    - 19187:9187
    depends_on:
    - haproxy
    restart: unless-stopped
  prometheus_patroni:
    image: prom/prometheus:latest
    container_name: citus_prometheus_patroni
    hostname: prometheus-patroni
    networks:
    - citus_net
    ports:
    - 19090:9090
    volumes:
    - ./prometheus-patroni.yml:/etc/prometheus/prometheus.yml:ro
    - prometheus_patroni_data:/prometheus
    command:
    - --config.file=/etc/prometheus/prometheus.yml
    - --storage.tsdb.path=/prometheus
    - --web.console.libraries=/etc/prometheus/console_libraries
    - --web.console.templates=/etc/prometheus/consoles
    - --storage.tsdb.retention.time=200h
    - --web.enable-lifecycle
    depends_on:
    - postgres_exporter_patroni
    restart: unless-stopped
  grafana_patroni:
    image: grafana/grafana:latest
    container_name: citus_grafana_patroni
    hostname: grafana-patroni
    networks:
    - citus_net
    ports:
    - 13000:3000
    environment:
      GF_SECURITY_ADMIN_PASSWORD: admin
      GF_USERS_ALLOW_SIGN_UP: false
    volumes:
    - grafana_patroni_data:/var/lib/grafana
    depends_on:
    - prometheus_patroni
    restart: unless-stopped
volumes:
  etcd1_data: null
  etcd2_data: null
  etcd3_data: null
  coordinator1_data: null
  coordinator2_data: null
  coordinator3_data: null
  worker1_primary_data: null
  worker1_standby_data: null
  worker2_primary_data: null
  worker2_standby_data: null
  prometheus_patroni_data: null
  grafana_patroni_data: null
